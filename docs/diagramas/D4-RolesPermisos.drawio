as" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="508" width="235" height="26" as="geometry"/></mxCell><mxCell id="c102" value="POST /api/admin/mantenimiento/finalizar-reservas" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="265" y="508" width="515" height="26" as="geometry"/></mxCell><mxCell id="c103" value="—" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="780" y="508" width="90" height="26" as="geometry"/></mxCell><mxCell id="c104" value="—" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="870" y="508" width="90" height="26" as="geometry"/></mxCell><mxCell id="c105" value="—" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="960" y="508" width="95" height="26" as="geometry"/></mxCell><mxCell id="c106" value="✓" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e2eee6;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1055" y="508" width="85" height="26" as="geometry"/></mxCell><mxCell id="c107" value="Reglas que acompañan a los roles:&lt;br&gt;· Sin token → 401 &quot;Debes iniciar sesión&quot; · token de otro rol → 403 &quot;No tienes permiso para esta acción&quot; · cuenta desactivada → 401 (Seguridad.py:79-81).&lt;br&gt;· Multi-tenant: el propietario_id sale del token, nunca del cuerpo; pedir una sede o cancha ajena responde 404 (Propietario.py:32-44).&lt;br&gt;· Nadie se registra como admin: RegistroEntrada solo admite rol cliente o propietario (Modelos.py:29). El admin no puede desactivarse a sí mismo (Admin.py:101)." style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f4f5ef;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=6;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1110" height="92" as="geometry"/></mxCell><mxCell id="c108" value="✓ = permitido · — = la API responde 401 (sin sesión) o 403 (rol equivocado). &quot;Visitante&quot; = sin iniciar sesión." style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#555a61;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1110" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>