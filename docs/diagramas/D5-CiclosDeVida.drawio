idth=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="c7" value="activa" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1d5a3c;strokeColor=#174a31;fontColor=#f4f5ef;fontSize=13;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="200" y="148" width="150" height="46" as="geometry"/></mxCell><mxCell id="c8" value="cancelada" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f4f5ef;strokeColor=#174a31;fontColor=#24272c;fontSize=13;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="150" height="46" as="geometry"/></mxCell><mxCell id="c9" value="finalizada" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f4f5ef;strokeColor=#174a31;fontColor=#24272c;fontSize=13;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="150" height="46" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="62" y="171" as="sourcePoint"/><mxPoint x="200" y="171" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="POST /api/reservas&lt;br&gt;POST /reservas/bloqueos" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="56" y="120" width="150" height="34" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;exitX=0.267;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="194" as="sourcePoint"/><mxPoint x="195" y="330" as="targetPoint"/><Array as="points"><mxPoint x="240" y="260"/><mxPoint x="195" y="260"/></Array></mxGeometry></mxCell><mxCell id="c13" value="Jugador cancela con ≥ 24 h&lt;br&gt;(Reservas.py:156-187)&lt;br&gt;o el dueño quita el bloqueo&lt;br&gt;(Reservas.py:253-262)" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="262" width="162" height="64" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;exitX=0.800;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="194" as="sourcePoint"/><mxPoint x="435" y="330" as="targetPoint"/><Array as="points"><mxPoint x="320" y="260"/><mxPoint x="435" y="260"/></Array></mxGeometry></mxCell><mxCell id="c15" value="Ya pasó hora_fin: FinalizarReservas&lt;br&gt;o POST /admin/mantenimiento/&lt;br&gt;finalizar-reservas (CicloDeVida.py:32)" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="220" height="54" as="geometry"/></mxCell><mxCell id="c16" value="· Solo &quot;activa&quot; está en el índice único parcial: al cancelar o finalizar, la franja deja de ocupar el índice.&lt;br&gt;· Al cancelar: pago.estado → reembolsado y, si había partido, partido_abierto.estado → cerrado.&lt;br&gt;· Cancelar exige estado activa en el filtro de find_one_and_update: dos cancelaciones&lt;br&gt;  simultáneas no se pisan.&lt;br&gt;· La finalización no es automática: la corre el admin o el script (idempotente).&lt;br&gt;· Errores: cancelar una finalizada → 409 &quot;Esta reserva ya se jugó&quot;; una cancelada → 409." style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f4f5ef;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="520" height="132" as="geometry"/></mxCell><mxCell id="c17" value="Partido abierto (partido_abierto.estado)" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#174a31;fontSize=14;fontFamily=Helvetica;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="92" width="540" height="22" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#24272c;strokeColor=#24272c;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="610" y="160" width="22" height="22" as="geometry"/></mxCell><mxCell id="c19" value="abierto" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1d5a3c;strokeColor=#174a31;fontColor=#f4f5ef;fontSize=13;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="148" width="150" height="46" as="geometry"/></mxCell><mxCell id="c20" value="completo" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#1d5a3c;strokeColor=#174a31;fontColor=#f4f5ef;fontSize=13;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="148" width="150" height="46" as="geometry"/></mxCell><mxCell id="c21" value="cerrado" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f4f5ef;strokeColor=#174a31;fontColor=#24272c;fontSize=13;fontFamily=Helvetica;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="870" y="330" width="150" height="46" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="632" y="171" as="sourcePoint"/><mxPoint x="760" y="171" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="Reserva con&lt;br&gt;abierta = true y&lt;br&gt;modalidad ≥ 4&lt;br&gt;jugadores" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="610" y="194" width="140" height="64" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;exitX=1.000;exitY=0.304;exitDx=0;exitDy=0;entryX=0.000;entryY=0.304;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="162" as="sourcePoint"/><mxPoint x="990" y="162" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="se une el&lt;br&gt;último cupo" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="900" y="112" width="110" height="34" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;exitX=0.000;exitY=0.739;exitDx=0;exitDy=0;entryX=1.000;entryY=0.739;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="182" as="sourcePoint"/><mxPoint x="910" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="alguien&lt;br&gt;sale" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="900" y="188" width="100" height="34" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"><mxPoint x="835" y="194" as="sourcePoint"/><mxPoint x="870" y="353" as="targetPoint"/><Array as="points"><mxPoint x="835" y="353"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#174a31;strokeWidth=1.5;startArrow=none;endArrow=block;startFill=1;endFill=1;startSize=10;endSize=10;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="194" as="sourcePoint"/><mxPoint x="1020" y="353" as="targetPoint"/><Array as="points"><mxPoint x="1065" y="353"/></Array></mxGeometry></mxCell><mxCell id="c30" value="el organizador&lt;br&gt;cancela la reserva" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="870" y="284" width="150" height="34" as="geometry"/></mxCell><mxCell id="c31" value="· Unirse: hasta 2 h antes, con una sola find_one_and_update que exige cupo, que no seas el&lt;br&gt;  organizador y que no estés ya unido (Partidos.py:90-104).&lt;br&gt;· Cuota = precio_total / cupos, redondeada hacia arriba a la centena (Reservas.py:126).&lt;br&gt;· Salir: siempre que no haya empezado; la cuota se devuelve solo con ≥ 24 h (Partidos.py:129-151).&lt;br&gt;· Si la reserva queda finalizada, unirse o salir responde 409 &quot;Este partido ya se jugó&quot;." style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f4f5ef;strokeColor=#dde1da;fontColor=#24272c;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="540" height="132" as="geometry"/></mxCell><mxCell id="c32" value="Caja verde = estado vivo (puede cambiar) · Caja clara = estado final · Punto negro = creación.&lt;br&gt;Las transiciones con hora usan la hora del SERVIDOR en Bogotá (Utilidades.py: ahora())." style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#555a61;fontSize=12;fontFamily=Helvetica;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=0;spacing=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="1110" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>